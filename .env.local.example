# ============================================================
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to git — it contains secrets.
# ============================================================

# Supabase — from your Supabase project settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin login — pick your own email + a strong password
ADMIN_EMAIL=shareenhussain@truelegaladvice.com
ADMIN_PASSWORD=password123
# Any random long string, used to sign login sessions. Generate one at
# https://generate-secret.vercel.app/32 or run: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Email notifications — from resend.com after verifying your domain
RESEND_API_KEY=your-resend-api-key
NOTIFY_EMAIL_TO=contact@truelegaladvice.in

# WhatsApp notifications — from Meta Business dashboard (developers.facebook.com)
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
NOTIFY_WHATSAPP_TO=919876543210
